{
  "name": "ultimate-soulcodex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Enterprise monorepo for SoulCodex: Engine of the Eternal Now",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bboy9090/Ultimate-SoulCodex.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && node scripts/generate-pwa-service-worker.mjs && node scripts/validate-pwa-output.mjs && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:capacitor": "vite build && node scripts/generate-pwa-service-worker.mjs && node scripts/validate-pwa-output.mjs && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:workspaces": "npm run build -w @soulcodex/db --if-present && npm run build -w @soulcodex/core --if-present",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "check:workspaces": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:account-deletion": "node --import tsx --test tests/account-deletion.test.ts",
    "clean": "npm run clean --workspaces --if-present",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "icons": "node scripts/generate-icons.mjs",
    "splash": "node scripts/generate-splash.mjs",
    "store:feature-graphic": "node scripts/generate-store-feature-graphic.mjs",
    "cap:icons": "npm run icons && npm run splash",
    "cap:build": "npm run build:capacitor && npx cap sync",
    "mobile:validate:ios": "node scripts/validate-mobile-release.mjs ios",
    "mobile:validate:android": "node scripts/validate-mobile-release.mjs android",
    "mobile:patch:ios": "node scripts/patch-apple-sign-in-swiftpm.mjs",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android"
  },
  "dependencies": {

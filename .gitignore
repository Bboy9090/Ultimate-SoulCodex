# Node / package managers
node_modules/
npm_cache/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
.turbo/
.vite/
.next/
out/
server/public/
index.js
index-*.js
index-*.css
index.es-*.js
html2canvas.esm-*.js
jspdf.es.min-*.js
purify.es-*.js
*.tar.gz
*.zip

# TypeScript build artifacts (tsc without outDir)
*.js
packages/**/**/*.js
apps/**/**/*.js
services/**/**/*.js
server/**/*.js
shared/**/*.js
*.js.map
*.d.ts.map

# Allow JS configs/scripts that are intentionally committed
!*.config.js
!*.config.cjs
!*.config.mjs
!scripts/**/*.js

# Local/system state
.DS_Store
vite.config.ts.*
.agent_state_*.bin
repl_state.bin
legion_runs/
__pycache__/
*.egg-info/

# Build markers
rapid_build_started
rapid_build_success

# Temporary scripts
apply_vite_server_fix_and_push.sh
create_pr_and_files.sh

# Environment variables
.env
.env.local
.env.*.local

# Ignore generated credentials from google-github-actions/auth
gha-creds-*.json

#
# SOUL CODEX - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values.
#
# DEMO MODE NOTE:
#   Omitting DATABASE_URL runs the active Foundation server with MemStorage.
#   Server-side profiles will be lost on restart. Local-first browser profiles
#   remain on the user's device.
#

# Server Configuration
NODE_ENV=development
PORT=5000

# App
APP_NAME=Soul Codex
# Production origin used for Stripe success/cancel redirects and CORS.
# Must be HTTPS in production. Localhost HTTP is accepted for development.
PUBLIC_APP_URL=http://localhost:5000
# VITE_APP_NAME=Soul Codex
# VITE_API_URL=https://api.your-production-domain.com
# CAPACITOR_SERVER_URL=https://your-production-domain.com

# Session
# The active Foundation web server does not initialize cookie sessions.
# Keep this only for legacy authenticated-route development until that route
# stack is deliberately reconciled with the active server.
# SESSION_SECRET=generate_a_strong_random_value

# Database (PostgreSQL - recommended for persistent server storage)
# DATABASE_URL=postgresql://user:password@host:port/database

# ------------------------------------------------------------------
# Secure billing through hosted Stripe Checkout
# Soul Codex must never collect card numbers, CVC/CVV, or expiry dates.
# All four values are required before /api/billing/status reports enabled=true.
# ------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Configure Stripe to send checkout events to:
# https://your-production-domain.com/api/billing/webhook

# Google Gemini AI
# Obtain a key from https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Apple Sign-In (paused until the native lane resumes)
# APPLE_CLIENT_ID=app.soulcodex.ios

# ------------------------------------------------------------------
# AI Keys
# ------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini

# Astrology API (optional)
# ASTRO_API_KEY=your_astro_api_key_here

# ------------------------------------------------------------------
# Push Notifications
# ------------------------------------------------------------------
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here
VAPID_SUBJECT=mailto:support@soulcodex.app

# ------------------------------------------------------------------
# Admin Access
# ------------------------------------------------------------------
ADMIN_PASSWORD=your_secure_admin_password_here

# ------------------------------------------------------------------
# Optional separate Next.js frontend
# ------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://api.soulcodex.app

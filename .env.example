#
# SOUL CODEX - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values.
#
# DEMO MODE NOTE:
#   Omitting DATABASE_URL runs the active Foundation server with MemStorage.
#   Server-side profiles will be lost on restart. Local-first browser profiles
#   remain on the user's device. Billing and durable authenticated ownership
#   require PostgreSQL in production.
#

# Server Configuration
NODE_ENV=development
PORT=5000

# App
APP_NAME=Soul Codex
# Production origin used for Stripe success/cancel redirects and CORS.
# Must be HTTPS in production. Localhost HTTP is accepted for development.
PUBLIC_APP_URL=http://localhost:5000
# VITE_APP_NAME=Soul Codex
# Required when building the bundled iOS/Android apps. The client uses this
# HTTPS origin for /api requests instead of the Capacitor localhost origin.
# VITE_API_URL=https://api.your-production-domain.com
#
# Release identity. CI supplies these for 4.0.1 builds. A production backend
# should expose the same release SHA through /health so client↔server skew is
# visible and can be gated rather than guessed.
# VITE_RELEASE_VERSION=4.0.1
# VITE_RELEASE_SHA=<exact-client-git-sha>
# VITE_API_CONTRACT=foundation-v4
# SOUL_CODEX_RELEASE_VERSION=4.0.1
# SOUL_CODEX_RELEASE_SHA=<exact-deployed-server-git-sha>
# CAPACITOR_SERVER_URL=https://your-production-domain.com

# Session
# Required by the active production server. Use a long, random secret and keep
# it stable across deploys so authenticated sessions do not disappear on every
# restart. Production sessions are stored in PostgreSQL when DATABASE_URL is set.
# SESSION_SECRET=generate_a_long_random_value

# Database (PostgreSQL - required for durable accounts, profiles, and billing)
# DATABASE_URL=postgresql://user:password@host:port/database

# ------------------------------------------------------------------
# Soul Codex+ subscription verification
# Soul Codex must never collect card numbers, CVC/CVV, or expiry dates.
# Web purchase initiation is disabled by default. Set
# SOUL_CODEX_PLUS_WEB_CHECKOUT_ENABLED=true only after web checkout,
# subscription management, and entitlement verification gates pass.
# Native StoreKit / Play Billing remain separate release gates.
#
# The signed Stripe webhook may verify already-created subscription lifecycle
# events into the durable entitlement ledger when DATABASE_URL and these values
# are configured. Unknown price IDs never grant access.
# ------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PLUS_MONTHLY_PRICE_ID=price_...
# STRIPE_PLUS_ANNUAL_PRICE_ID=price_...
# Configure Stripe customer.subscription.* events to:
# https://your-production-domain.com/api/billing/webhook

#
# Native billing stays OFF until both store catalogs and server verification
# credentials are configured. Product IDs are returned to the native shell
# from /api/billing/native-catalog and are not hard-coded into the UI.
# SOUL_CODEX_PLUS_NATIVE_BILLING_ENABLED=false
# APPLE_PLUS_MONTHLY_PRODUCT_ID=app.soulcodex.plus.monthly
# APPLE_PLUS_ANNUAL_PRODUCT_ID=app.soulcodex.plus.annual
# APPLE_APP_ID=<numeric App Store app id>
# APPLE_IAP_ROOT_CERTS_BASE64=<comma-separated DER certificates encoded as base64>
# Production defaults to accepting only Production StoreKit evidence.
# For sandbox/TestFlight validation, explicitly set:
# APPLE_IAP_ALLOWED_ENVIRONMENTS=sandbox
# To permit both during a controlled transition:
# APPLE_IAP_ALLOWED_ENVIRONMENTS=production,sandbox
# GOOGLE_PLAY_PLUS_MONTHLY_PRODUCT_ID=soul_codex_plus_monthly
# GOOGLE_PLAY_PLUS_ANNUAL_PRODUCT_ID=soul_codex_plus_annual
# GOOGLE_PLAY_PACKAGE_NAME=soulcodex.app
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=<service account JSON string>

# Google Gemini AI
# Obtain a key from https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Apple Sign-In
# Native iOS identity tokens use the Xcode bundle/App ID as their audience.
# This must match ios/App/App.xcodeproj: app.soulcodex.ios.
# APPLE_CLIENT_ID=app.soulcodex.ios

# ------------------------------------------------------------------
# AI Keys
# ------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini

# Astrology API (optional)
# ASTRO_API_KEY=your_astro_api_key_here

# ------------------------------------------------------------------
# Push Notifications
# ------------------------------------------------------------------
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here
VAPID_SUBJECT=mailto:support@soulcodex.app

# ------------------------------------------------------------------
# Admin Access
# ------------------------------------------------------------------
ADMIN_PASSWORD=your_secure_admin_password_here

# ------------------------------------------------------------------
# Optional separate Next.js frontend
# ------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://api.soulcodex.app

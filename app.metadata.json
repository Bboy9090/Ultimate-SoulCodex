{
  "appId": "app.soulcodex.main",
  "appName": "Soul Codex",
  "appVersion": "4.0.0-rc.4",
  "appDescription": "A personal insight and self-reflection app combining verified astronomy inputs, numerology, Human Design, compatibility, timeline tools, and AI-assisted guidance.",
  "appTagline": "Your personal identity operating system",
  "author": "Bobby's World",
  "authorUrl": "https://bobbysworld.dev",
  "repositoryUrl": "https://github.com/Bboy9090/Ultimate-SoulCodex",
  "homepage": "https://soulcodex.up.railway.app",
  "license": "PROPRIETARY",
  "platform": {
    "web": {
      "enabled": true,
      "url": "https://soulcodex.up.railway.app",
      "pwa": true
    },
    "ios": {
      "enabled": true,
      "bundleId": "app.soulcodex.ios",
      "appStoreId": null
    },
    "android": {
      "enabled": true,
      "packageName": "app.soulcodex.main",
      "playStoreId": null,
      "versionName": "4.0.0-rc.4",
      "versionCode": 4000004,
      "targetSdk": 36
    },
    "windows": {
      "enabled": false,
      "msixPackageId": "BobbysWorld.SoulCodex"
    },
    "blueprintOS": {
      "enabled": true,
      "packageId": "app.soulcodex.main",
      "category": "personal-growth"
    }
  },
  "features": {
    "profileOnboarding": {
      "enabled": true,
      "description": "Create a local-first profile with birth data and behavioral patterns"
    },
    "readingDashboard": {
      "enabled": true,
      "description": "Evidence-aware synthesis across supported astronomy, numerology, Human Design, and behavioral inputs"
    },
    "journalSystem": {
      "enabled": true,
      "backend": true,
      "frontend": false,
      "description": "Guided reflection prompts with mood tracking backend support"
    },
    "savedInsights": {
      "enabled": false,
      "description": "Bookmark and revisit key reading sections"
    },
    "compatibility": {
      "enabled": true,
      "description": "Relationship compatibility analysis between two profiles"
    },
    "dailyContext": {
      "enabled": true,
      "description": "Daily timing and reflection context"
    },
    "aiSynthesis": {
      "enabled": true,
      "requiresApiKey": false,
      "description": "AI-assisted Soul Guide and reading prose with evidence and safety boundaries",
      "userReporting": {
        "enabled": true,
        "endpoint": "/api/ai-content-report"
      }
    },
    "pdfExport": {
      "enabled": true,
      "description": "Export supported readings to PDF"
    }
  },
  "requirements": {
    "node": "22.x",
    "npm": ">=10.0.0",
    "database": {
      "optional": true,
      "type": "PostgreSQL",
      "note": "Local-first flows can operate without a persistent database; server-backed features use production storage when configured"
    },
    "externalAPIs": {
      "required": false,
      "aiProviders": {
        "optional": true,
        "note": "Requested AI-assisted features use configured server-side AI providers; deterministic fallbacks remain available for supported flows"
      }
    }
  },
  "configuration": {
    "envVarsRequired": [
      "SESSION_SECRET"
    ],
    "envVarsOptional": [
      "DATABASE_URL",
      "GEMINI_API_KEY",
      "OPENAI_API_KEY",
      "DEMO_MODE"
    ],
    "ports": {
      "default": 5000,
      "configurable": true
    }
  },
  "storage": {
    "userProfiles": {
      "type": "local device and/or production database for requested server-backed features",
      "encryptedAtRest": "depends on device and production database/host configuration"
    },
    "journalEntries": {
      "type": "database or local storage depending on enabled surface",
      "encrypted": false,
      "note": "Do not market client-side encryption until implemented and verified"
    },
    "savedInsights": {
      "type": "localStorage",
      "encrypted": false
    },
    "aiSafetyReports": {
      "type": "server operational logs",
      "userInitiated": true,
      "maxExcerptCharacters": 2000,
      "maxDetailsCharacters": 1000
    }
  },
  "screens": [
    {
      "route": "/",
      "name": "Home",
      "description": "Welcome and product entry point"
    },
    {
      "route": "/create",
      "name": "Create Profile",
      "description": "Local-first profile creation flow"
    },
    {
      "route": "/profile/:id",
      "name": "Profile",
      "description": "Identity and supported system reading"
    },
    {
      "route": "/reading/:id",
      "name": "Reading",
      "description": "Evidence-aware reading experience"
    },
    {
      "route": "/compatibility",
      "name": "Compatibility",
      "description": "Relationship compatibility experience"
    },
    {
      "route": "/timeline",
      "name": "Timeline",
      "description": "Life timing and continuity view"
    },
    {
      "route": "/systems",
      "name": "Systems",
      "description": "Underlying-system evidence inspector"
    },
    {
      "route": "/settings",
      "name": "Settings",
      "description": "Local data, account, diagnostics, support, and deletion controls"
    }
  ],
  "buildArtifacts": {
    "web": {
      "outputDir": "dist/public",
      "entryPoint": "dist/index.js"
    },
    "android": {
      "apkOutput": "android/app/build/outputs/apk/",
      "aabOutput": "android/app/build/outputs/bundle/",
      "storeFormat": "AAB"
    },
    "ios": {
      "project": "ios/App/App.xcodeproj",
      "scheme": "Soul Codex"
    },
    "windows": {
      "format": "MSIX",
      "outputDir": "packaging/windows/",
      "instructions": "packaging/README.md"
    },
    "blueprintOS": {
      "format": "AppImage",
      "outputDir": "packaging/blueprintos/",
      "instructions": "packaging/README.md"
    }
  },
  "healthcheck": {
    "script": "scripts/healthcheck.sh",
    "checks": [
      "Core configuration validation",
      "Storage path accessibility",
      "Required screens/routes responding",
      "Environment variables present"
    ]
  },
  "smokeTest": {
    "script": "scripts/smoke-test.sh",
    "tests": [
      "Server starts without errors",
      "Landing page loads",
      "Profile onboarding flow works",
      "Reading generation succeeds",
      "API endpoints respond correctly"
    ]
  },
  "knownLimitations": [
    "Journal UI page pending implementation",
    "Saved insights UI pending implementation",
    "English only (no i18n/localization)",
    "Google Play production signing and console admission remain external release gates"
  ],
  "releaseDate": null,
  "minimumVersion": "4.0.0-rc.4",
  "releaseNotes": "Android rc.4 aligns package identity, API 36 targeting, Moon/Rising refresh behavior, and in-app AI safety reporting for Google Play readiness.",
  "supportContact": {
    "email": "support@soulcodex.app",
    "privacyEmail": "privacy@soulcodex.app",
    "github": "https://github.com/Bboy9090/Ultimate-SoulCodex/issues"
  }
}

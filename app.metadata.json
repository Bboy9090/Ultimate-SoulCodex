{
  "appId": "app.soulcodex.main",
  "appName": "Soul Codex",
  "appVersion": "4.0.1",
  "appDescription": "Evidence-aware symbolic self-reflection using governed astrology, numerology, and qualified Human Design context.",
  "appTagline": "Know How You're Wired",
  "author": "Bobby's World",
  "authorUrl": "https://bobbysworld.dev",
  "repositoryUrl": "https://github.com/Bboy9090/Ultimate-SoulCodex",
  "homepage": "https://soulcodex.up.railway.app",
  "license": "PROPRIETARY",
  "platform": {
    "web": {
      "enabled": true,
      "url": "https://soulcodex.up.railway.app",
      "pwa": true
    },
    "ios": {
      "enabled": true,
      "bundleId": "app.soulcodex.ios",
      "appStoreId": null
    },
    "android": {
      "enabled": true,
      "packageName": "app.soulcodex.main",
      "playStoreId": null
    },
    "windows": {
      "enabled": false,
      "msixPackageId": "BobbysWorld.SoulCodex"
    },
    "blueprintOS": {
      "enabled": true,
      "packageId": "com.bobbysworld.soulcodex",
      "category": "personal-growth"
    }
  },
  "features": {
    "profileOnboarding": {
      "enabled": true,
      "description": "Create a reusable profile from birth data. Missing or unsafe inputs remain unresolved rather than guessed."
    },
    "readingDashboard": {
      "enabled": true,
      "description": "Evidence-aware synthesis of governed astrology and deterministic numerology, with Human Design shown only when its verified-core contract passes."
    },
    "journalSystem": {
      "enabled": true,
      "backend": true,
      "frontend": false,
      "description": "100+ guided reflection prompts with mood tracking"
    },
    "savedInsights": {
      "enabled": false,
      "description": "Bookmark and revisit key reading sections"
    },
    "compatibility": {
      "enabled": true,
      "description": "Symbolic relationship-theme comparison using only the supported evidence available to the active Foundation model."
    },
    "dailyContext": {
      "enabled": true,
      "description": "Context-qualified daily reflection using governed timing inputs; unsupported legacy Tarot, I Ching, and Gene Keys fallbacks are excluded."
    },
    "aiSynthesis": {
      "enabled": true,
      "requiresApiKey": true,
      "description": "AI-assisted narrative generation constrained by supported profile evidence and interpretation boundaries."
    },
    "pdfExport": {
      "enabled": true,
      "description": "Download governed profile/report output when the relevant entitlement and release gate are satisfied."
    }
  },
  "requirements": {
    "node": "20.x",
    "npm": ">=10.0.0",
    "database": {
      "optional": true,
      "type": "PostgreSQL",
      "note": "Demo mode works without database"
    },
    "externalAPIs": {
      "required": false,
      "gemini": {
        "optional": true,
        "note": "AI synthesis requires GEMINI_API_KEY or OPENAI_API_KEY"
      },
      "openai": {
        "optional": true,
        "note": "Fallback for AI synthesis"
      }
    }
  },
  "configuration": {
    "envVarsRequired": [
      "SESSION_SECRET"
    ],
    "envVarsOptional": [
      "DATABASE_URL",
      "GEMINI_API_KEY",
      "OPENAI_API_KEY",
      "DEMO_MODE"
    ],
    "ports": {
      "default": 5000,
      "configurable": true
    }
  },
  "storage": {
    "userProfiles": {
      "type": "database or in-memory",
      "encryptedAtRest": "depends on DB/host configuration",
      "note": "Demo mode uses in-memory storage"
    },
    "journalEntries": {
      "type": "database or localStorage",
      "encrypted": false,
      "note": "Client-side encryption planned for v1.1"
    },
    "savedInsights": {
      "type": "localStorage",
      "encrypted": false
    }
  },
  "screens": [
    {
      "route": "/",
      "name": "Home",
      "description": "Foundation entry and product overview"
    },
    {
      "route": "/create",
      "name": "Create Identity",
      "description": "Profile creation flow"
    },
    {
      "route": "/profile",
      "name": "Identity",
      "description": "Saved evidence-aware identity view"
    },
    {
      "route": "/reading",
      "name": "Reading",
      "description": "Quick / Standard / Deep Dive reflective reading"
    },
    {
      "route": "/today",
      "name": "Today",
      "description": "Context-qualified daily reflection"
    },
    {
      "route": "/compatibility",
      "name": "Compatibility",
      "description": "Symbolic relationship-theme exploration"
    },
    {
      "route": "/timeline",
      "name": "Timeline",
      "description": "Timing and tracked-pattern context"
    },
    {
      "route": "/guide",
      "name": "Soul Guide",
      "description": "AI-assisted profile-grounded reflection when available"
    }
  ],
  "buildArtifacts": {
    "web": {
      "outputDir": "dist/public",
      "entryPoint": "dist/index.js"
    },
    "windows": {
      "format": "MSIX",
      "outputDir": "packaging/windows/",
      "instructions": "packaging/README.md"
    },
    "blueprintOS": {
      "format": "AppImage",
      "outputDir": "packaging/blueprintos/",
      "instructions": "packaging/README.md"
    }
  },
  "healthcheck": {
    "script": "scripts/healthcheck.sh",
    "checks": [
      "Core configuration validation",
      "Storage path accessibility",
      "Required screens/routes responding",
      "Environment variables present"
    ]
  },
  "smokeTest": {
    "script": "scripts/smoke-test.sh",
    "tests": [
      "Server starts without errors",
      "Landing page loads",
      "Profile onboarding flow works",
      "Reading generation succeeds",
      "API endpoints respond correctly"
    ]
  },
  "knownLimitations": [
    "Purchasing is not enabled in the current native release candidate.",
    "Systems that have not passed calculation, evidence, privacy, interpretation, and release contracts remain quarantined.",
    "Exact-time astrology and verified Human Design remain unresolved when their required evidence is missing.",
    "English only (no i18n/localization)."
  ],
  "releaseDate": null,
  "minimumVersion": "4.0.1",
  "releaseNotes": "Foundation release with evidence-aware astrology, deterministic numerology, qualified Human Design support, selective daily guidance, and symbolic compatibility.",
  "supportContact": {
    "email": "support@bobbysworld.dev",
    "github": "https://github.com/Bboy9090/Ultimate-SoulCodex/issues"
  }
}
